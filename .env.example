# Aucune source actuelle n'exige de clé API. Ne jamais committer de fichier .env.

# Chemin de base du site (GitHub Pages : /nom-du-depot/ ; VPS à la racine : /)
VITE_BASE_PATH=/

# Optionnel : contact envoyé dans l'en-tête User-Agent des requêtes de collecte (politesse envers les serveurs)
COLLECT_CONTACT=
